# Cardly Server Configuration
# Copy this file to `.env` and set your own credentials before running.

# Bind host and port
CARDLY_HOST=0.0.0.0
CARDLY_PORT=8080

# Persistent data directory (collections, media, backups, user settings)
CARDLY_DATA_DIR=./data

# Users in `username:password` format (same convention as Anki's built-in sync server).
# Add CARDLY_USER2, CARDLY_USER3, ... for additional accounts.
# Each user gets their own isolated collection and Anki sync endpoint.
CARDLY_USER1=alice:change-me-please

# Optional: set to 1 if passwords above are pre-hashed PBKDF2 PHC strings
PASSWORDS_HASHED=0

# Optional: secret used to sign browser session cookies.
# If left empty, Cardly generates and persists a random 256-bit secret in $CARDLY_DATA_DIR/.session_secret.
CARDLY_SESSION_SECRET=

# Set to true when serving behind HTTPS (reverse proxy / TLS)
CARDLY_COOKIE_SECURE=false

# Maximum upload size in MiB (applies to .apkg/.colpkg/media uploads)
CARDLY_MAX_UPLOAD_MB=512

# Logging filter (rust tracing syntax)
RUST_LOG=cardly_server=info,anki=info,tower_http=info
